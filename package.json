{
  "name": "findinpage",
  "description": "Context-rich find-in-page search for Chrome",
  "private": true,
  "version": "1.0.6",
  "packageManager": "pnpm@10.13.1",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:safari": "wxt build -b safari --mv2",
    "build:firefox": "wxt build -b firefox",
    "build:demo": "vite build --config vite.demo.config.ts && node scripts/write-demo-manifest.mjs",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "xcode:generate": "xcodegen generate --spec safari/project.yml --project safari",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@wxt-dev/i18n": "^0.2.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "@wxt-dev/module-react": "^1.1.5",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.0.2",
    "wxt": "^0.20.25"
  }
}
